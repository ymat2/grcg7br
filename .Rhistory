chrom_axis = GRCg7b_sequence_report |>
dplyr::rename(CHROM = `RefSeq seq accession`, chr = `Chromosome name`, length = `Seq length`) |>
dplyr::mutate(chr = dplyr::if_else(stringr::str_detect(chr, "^NW"), "Un", chr)) |>
dplyr::mutate(cumsum_seq_length = dplyr::lag(cumsum(length), default = 0)) |>
dplyr::mutate(center = length / 2)
View(chrom_axis)
chrom_axis = GRCg7b_sequence_report |>
dplyr::rename(CHROM = `RefSeq seq accession`, chr = `Chromosome name`, length = `Seq length`) |>
dplyr::mutate(chr = dplyr::if_else(stringr::str_detect(chr, "^NW"), "Un", chr)) |>
dplyr::mutate(cumsum_seq_length = dplyr::lag(cumsum(length), default = 0)) |>
dplyr::mutate(sumsum_center = length / 2 + cumsum_seq_length)
chrom_axis = GRCg7b_sequence_report |>
dplyr::rename(CHROM = `RefSeq seq accession`, chr = `Chromosome name`, length = `Seq length`) |>
dplyr::mutate(chr = dplyr::if_else(stringr::str_detect(chr, "^NW"), "Un", chr)) |>
dplyr::mutate(cumsum_seq_length = dplyr::lag(cumsum(length), default = 0)) |>
dplyr::mutate(sumsum_center = length / 2 + cumsum_seq_length) |>
dplyr::group_by(chr) |>
dplyr::summarise(sumsum_center = mean(cumsum_center))
